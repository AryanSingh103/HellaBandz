# Research providers are optional. Account access requires Supabase settings below.
# Use operator mode explicitly for a local single-operator judge demo.
QS_AUTH_MODE=accounts
QS_AUTH_REQUIRED=1
QS_API_TOKEN=
QS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Pin your own public Devnet wallet, then run `make audit-up` after funding it.
QS_AUDIT_SIGNER=
QS_AUDIT_INTERVAL=300
# Keep comments on their own lines: Docker Compose treats `KEY=  # note` as the value "# note".

# Research agents, supervisor, crisis responses, /v1/ask phrasing
OPENAI_API_KEY=
QS_OPENAI_MODEL=gpt-4.1-mini

# Optional Claude text classifier for Nike Review Radar (offline ratings also work)
ANTHROPIC_API_KEY=
QS_ANTHROPIC_MODEL=claude-sonnet-4-6

# /v1/speak text-to-speech (browser speech is the fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# scripts/ingest_alpaca.py (free Basic plan)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

SOLANA_RPC=https://api.devnet.solana.com

# Database for host scripts. Containers use QS_DATABASE_URL (leave empty for the local db container).
# Tiger Cloud: set BOTH to the service URL, e.g. postgres://tsdbadmin:PASS@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=postgresql://quantswarm:quantswarm@127.0.0.1:5432/quantswarm
QS_DATABASE_URL=

NEXT_PUBLIC_API=http://localhost:8000

# Supabase provides user identity. DATABASE_URL remains the existing TimescaleDB.
# Use the same project URL and publishable key on server and frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: generate distinct values, never prefix with NEXT_PUBLIC_.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
QS_INTERNAL_SIGNING_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QS_CREDENTIAL_ENCRYPTION_KEY=

# Manual, capped YES IOC orders on Kalshi DEMO only. Production is always read-only.
QS_KALSHI_DEMO_ORDERS_ENABLED=false

# Explicit offline development opt-out; never enable on a deployed service.
QS_AUTH_DISABLED=false
NEXT_PUBLIC_QS_AUTH_DISABLED=false
