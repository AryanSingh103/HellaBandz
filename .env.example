# All optional. Without keys the system runs fully offline with recorded fixtures.
# Keep comments on their own lines: Docker Compose treats `KEY=  # note` as the value "# note".

# Research agents, supervisor, crisis responses, /v1/ask phrasing
OPENAI_API_KEY=
QS_OPENAI_MODEL=gpt-4.1-mini

# /v1/speak text-to-speech (browser speech is the fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# scripts/ingest_alpaca.py (free Basic plan)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

SOLANA_RPC=https://api.devnet.solana.com

# Database for host scripts. Containers use QS_DATABASE_URL (leave empty for the local db container).
# Tiger Cloud: set BOTH to the service URL, e.g. postgres://tsdbadmin:PASS@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=postgresql://quantswarm:quantswarm@localhost:5432/quantswarm
QS_DATABASE_URL=

NEXT_PUBLIC_API=http://localhost:8000
